{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "BRIEFING.md"
  ],
  "provider": {
    "cadra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cadra",
      "options": {
        "baseURL": "https://proxy.cadra.info/v1",
        "apiKey": "{file:~/.config/opencode/cadra-api-key}"
      },
      "models": {
        "cadra": {
          "name": "Cadra",
          "tool_call": true
        }
      }
    }
  },
  "enabled_providers": [
    "cadra"
  ],
  "model": "cadra/cadra",
  "small_model": "cadra/cadra",
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "rm -rf *": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
